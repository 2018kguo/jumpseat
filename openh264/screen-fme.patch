+#ifndef JUMPSEAT_FME_XSTEP
+#define JUMPSEAT_FME_XSTEP 8
+#endif
+// jumpseat: the per-pixel 8x8 sums of SumOf8x8BlockOfFrame_c from running
+// column sums (~4 ops a pixel instead of 64), indexing only every
+// JUMPSEAT_FME_XSTEP-th column. Scrolls move content vertically, so the
+// matches sit at the block's own x, which is always indexed.
+void SumOf8x8BlockOfFrame_sliding (uint8_t* pRefPicture, const int32_t kiWidth, const int32_t kiHeight,
+                                   const int32_t kiRefStride,
+                                   uint16_t* pFeatureOfBlock, uint32_t pTimesOfFeatureValue[]) {
+  const int32_t kiCols = kiWidth + 7;
+  uint16_t* pCol = static_cast<uint16_t*> (alloca (kiCols * sizeof (uint16_t)));
+  for (int32_t x = 0; x < kiCols; x++) {
+    uint16_t s = 0;
+    for (int32_t r = 0; r < 8; r++) s += pRefPicture[r * kiRefStride + x];
+    pCol[x] = s;
+  }
+  for (int32_t y = 0; y < kiHeight; y++) {
+    uint16_t* pBuffer = pFeatureOfBlock + kiWidth * y;
+    for (int32_t x = 0; x < kiWidth; x += JUMPSEAT_FME_XSTEP) {
+      const uint16_t* c = pCol + x;
+      const uint16_t iSum = c[0] + c[1] + c[2] + c[3] + c[4] + c[5] + c[6] + c[7];
+      pBuffer[x] = iSum;
+      pTimesOfFeatureValue[iSum]++;
+    }
+    if (y + 1 < kiHeight) {
+      const uint8_t* pOut = pRefPicture + y * kiRefStride;
+      const uint8_t* pIn = pOut + 8 * kiRefStride;
+      for (int32_t x = 0; x < kiCols; x++) pCol[x] += pIn[x] - pOut[x];
+    }
+  }
+}
+
+void FillQpelLocationByFeatureValue_sparse (uint16_t* pFeatureOfBlock, const int32_t kiWidth, const int32_t kiHeight,
+                                            uint16_t** pFeatureValuePointerList) {
+  for (int32_t y = 0; y < kiHeight; y++) {
+    const uint16_t* pSrc = pFeatureOfBlock + kiWidth * y;
+    for (int32_t x = 0; x < kiWidth; x += JUMPSEAT_FME_XSTEP) {
+      uint16_t* p = pFeatureValuePointerList[pSrc[x]];
+      p[0] = x << 2;
+      p[1] = y << 2;
+      pFeatureValuePointerList[pSrc[x]] = p + 2;
+    }
+  }
+}
